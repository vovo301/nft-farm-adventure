{
  "name": "nft-farm-adventure",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "econ:gen": "node economy/gen/generate.mjs",
    "econ:check": "node economy/gen/generate.mjs --check",
    "econ:sim": "node --disable-warning=ExperimentalWarning --import ./economy/sim/register-ts.mjs economy/sim/simulate.mjs && python3 economy/sim/plot.py"
  }
}
